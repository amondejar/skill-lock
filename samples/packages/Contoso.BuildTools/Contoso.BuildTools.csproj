<Project Sdk="Microsoft.NET.Sdk">
  <!-- A sample package that ships agent skills: skills/<name>/SKILL.md inside the .nupkg. -->
  <PropertyGroup>
    <TargetFramework>$(SkillLockTargetFramework)</TargetFramework>
    <IsPackable>true</IsPackable>
    <Version>1.0.0</Version>
    <Authors>Contoso</Authors>
    <Description>Sample package for SkillLock.</Description>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../feed</PackageOutputPath>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="skills/**/*" Pack="true" PackagePath="skills/" />
  </ItemGroup>
</Project>
